{
	"name": "discord-player-googlevideo",
	"version": "0.2.7",
	"description": "A discord-player extractor using YouTube SABR streaming with googlevideo and youtubei.js",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"lint": "biome check --write ./src",
		"tsc": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm clean && pnpm build && pnpm test"
	},
	"keywords": [
		"discord",
		"discord-player",
		"youtube",
		"extractor",
		"music",
		"streaming",
		"sabr",
		"youtubei",
		"googlevideo"
	],
	"author": "xxczaki",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/xxczaki/discord-bot.git",
		"directory": "packages/discord-player-googlevideo"
	},
	"bugs": {
		"url": "https://github.com/xxczaki/discord-bot/issues"
	},
	"homepage": "https://github.com/xxczaki/discord-bot/tree/main/packages/discord-player-googlevideo#readme",
	"peerDependencies": {
		"discord-player": "^7.2.0"
	},
	"dependencies": {
		"bgutils-js": "^4.0.3",
		"googlevideo": "^4.1.1",
		"jsdom": "^30.0.1",
		"youtubei.js": "^18.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/jsdom": "^30.0.0",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"discord-player": "^7.2.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
