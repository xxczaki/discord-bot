{
	"name": "discord-player-googlevideo",
	"version": "0.2.7",
	"description": "A discord-player extractor using YouTube SABR streaming with googlevideo and youtubei.js",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"lint": "biome check --write ./src",
		"tsc": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm clean && pnpm build && pnpm test"
	},
	"keywords": [
		"discord",
		"discord-player",
		"youtube",
		"extractor",
		"music",
		"streaming",
		"sabr",
		"youtubei",
		"googlevideo"
	],
	"author": "xxczaki",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/xxczaki/discord-bot.git",
		"directory": "packages/discord-player-googlevideo"
	},
	"bugs": {
		"url": "https://github.com/xxczaki/discord-bot/issues"
	},
	"homepage": "https://github.com/xxczaki/discord-bot/tree/main/packages/discord-player-googlevideo#readme",
	"peerDependencies": {
		"discord-player": "^7.2.0"
	},
	"dependencies": {
		"bgutils-js": "^4.0.3",
		"googlevideo": "^5.0.0",
		"jsdom": "^30.1.3",
		"youtubei.js": "^18.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/jsdom": "^30.0.0",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"discord-player": "^7.2.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
