{
	"name": "discord-player-googlevideo",
	"version": "0.2.7",
	"description": "A discord-player extractor using YouTube SABR streaming with googlevideo and youtubei.js",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"lint": "biome check --write ./src",
		"tsc": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm clean && pnpm build && pnpm test"
	},
	"keywords": [
		"discord",
		"discord-player",
		"youtube",
		"extractor",
		"music",
		"streaming",
		"sabr",
		"youtubei",
		"googlevideo"
	],
	"author": "xxczaki",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/xxczaki/discord-bot.git",
		"directory": "packages/discord-player-googlevideo"
	},
	"bugs": {
		"url": "https://github.com/xxczaki/discord-bot/issues"
	},
	"homepage": "https://github.com/xxczaki/discord-bot/tree/main/packages/discord-player-googlevideo#readme",
	"peerDependencies": {
		"discord-player": "^7.2.0"
	},
	"dependencies": {
		"bgutils-js": "^4.0.3",
		"googlevideo": "^4.1.1",
		"jsdom": "^30.1.1",
		"youtubei.js": "^18.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/jsdom": "^30.0.0",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"discord-player": "^7.2.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@11.28.4+sha512.f905a61563f89b49a292634d3d87d024cfdea9dccf5c66b2ccc261675fa7b2774320a959db472e6caa7f9ff7314709cd50d06c8fd64addb60647377a78d250ff"
}
