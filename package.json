{
	"name": "discord-bot",
	"version": "0.0.0",
	"description": "",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "pnpm recursive --include-workspace-root run build && node --env-file=.env dist/index.js | pino-pretty",
		"build": "node esbuild.js",
		"lint": "biome check --write ./src",
		"tsc": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm recursive run build && changeset publish",
		"prompt-benchmark": "tsx --env-file=.env src/benchmarks/promptBenchmark.ts"
	},
	"packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
	"dependencies": {
		"@ai-sdk/mistral": "^4.0.56",
		"@discord-player/extractor": "^7.2.0",
		"@kubernetes/client-node": "^2.0.0",
		"@sentry/node": "^10.75.3",
		"bufferutil": "^4.1.0",
		"discord-player": "^7.2.0",
		"discord-player-googlevideo": "workspace:*",
		"discord-player-spotify": "^1.1.9",
		"discord.js": "^14.27.0",
		"ioredis": "^6.0.0",
		"pino": "^10.3.1",
		"sodium-native": "^5.1.0",
		"ulid": "^3.0.2",
		"zlib-sync": "^0.1.10"
	},
	"devDependencies": {
		"@ai-sdk/openai": "^4.0.83",
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "^3.0.3",
		"@discordjs/rest": "^2.6.3",
		"@sentry/esbuild-plugin": "^5.4.0",
		"@snazzah/davey": "^0.1.12",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"ai": "^7.0.122",
		"date-fns": "^4.4.0",
		"esbuild": "^0.28.2",
		"esbuild-plugin-pino": "2.3.3",
		"fuse.js": "^7.5.0",
		"memoize": "^11.0.0",
		"p-debounce": "^5.1.1",
		"p-queue": "^9.3.3",
		"pino-pretty": "^13.1.3",
		"pretty-bytes": "^7.2.0",
