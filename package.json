{
	"name": "discord-bot",
	"version": "0.0.0",
	"description": "",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "pnpm recursive --include-workspace-root run build && node --env-file=.env dist/index.js | pino-pretty",
		"build": "node esbuild.js",
		"lint": "biome check --write ./src",
		"tsc": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm recursive run build && changeset publish",
		"prompt-benchmark": "node --env-file=.env src/benchmarks/promptBenchmark.ts"
	},
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"dependencies": {
		"@ai-sdk/mistral": "^4.0.74",
		"@discord-player/extractor": "^7.2.0",
		"@sentry/node": "^11.10.0",
		"bufferutil": "^4.1.0",
		"discord-player": "^7.2.0",
		"discord-player-googlevideo": "workspace:*",
		"discord-player-spotify": "^1.1.9",
		"discord.js": "^14.27.0",
		"ioredis": "^6.0.0",
		"pino": "^10.4.0",
		"sodium-native": "^5.2.0",
		"zlib-sync": "^0.1.10"
	},
	"devDependencies": {
		"@ai-sdk/openai": "^4.0.104",
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "^3.0.3",
		"@discordjs/rest": "^2.6.3",
		"@sentry/esbuild-plugin": "^11.10.0",
		"@snazzah/davey": "^0.1.12",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"ai": "^7.0.156",
		"esbuild": "^0.28.2",
		"esbuild-plugin-pino": "2.3.3",
		"fuse.js": "^7.5.0",
		"memoize": "^11.0.0",
		"p-debounce": "^6.0.0",
		"p-queue": "^10.0.0",
		"pino-pretty": "^13.2.0",
		"pretty-bytes": "^7.2.0",
		"transliteration": "^2.7.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "^4.6.7"
	}
